# Copy to android/keystore.properties (git-ignored) to sign release builds from
# Android Studio and scripts/build-android.sh alike. Environment variables
# (ANDROID_KEYSTORE, ANDROID_KEYSTORE_PASSWORD, ANDROID_KEY_ALIAS,
# ANDROID_KEY_PASSWORD) are used for any key missing here.
#
# Create the upload key once (keep it and its passwords backed up — with Play App
# Signing a lost upload key can be reset, but only via a support request):
#   keytool -genkeypair -v -keystore ~/keys/gymlog-upload.jks -alias upload \
#     -keyalg RSA -keysize 2048 -validity 10000

# Absolute, or relative to android/.
storeFile=/home/you/keys/gymlog-upload.jks
storePassword=change-me
keyAlias=upload
# Optional — defaults to storePassword.
keyPassword=change-me
