{
  "name": "gym-log-exercise-builder",
  "private": true,
  "license": "UNLICENSED",
  "version": "1.0.0",
  "type": "module",
  "description": "Gym Log — an offline-first training log: a readiness body map, a live set-by-set logger, session history and per-exercise stats.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "cap:sync": "cap sync",
    "cap:copy": "cap copy",
    "cap:add:android": "cap add android",
    "cap:add:ios": "cap add ios",
    "build:mobile": "npm run build && cap sync",
    "android": "npm run build && cap sync android && cap open android",
    "android:run": "npm run build && cap run android",
    "ios": "npm run build && cap sync ios && cap open ios",
    "ios:run": "npm run build && cap run ios",
    "build:android": "bash scripts/build-android.sh debug",
    "build:android:release": "bash scripts/build-android.sh release",
    "build:ios": "bash scripts/build-ios.sh sim",
    "build:ios:archive": "bash scripts/build-ios.sh archive",
    "play:assets": "node scripts/play-assets.mjs",
    "play:validate": "bundle exec fastlane android validate",
    "play:internal": "bundle exec fastlane android internal",
    "play:metadata": "bundle exec fastlane android metadata",
    "play:promote": "bundle exec fastlane android promote"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.3.4",
    "@types/three": "^0.184.1",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.4",
    "@capacitor/core": "^8.3.4",
    "@capacitor/ios": "^8.3.4",
    "@capacitor/local-notifications": "^8.3.1",
    "@fontsource/alfa-slab-one": "^5.3.0",
    "@fontsource/anton": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/bungee": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/oswald": "^5.3.0",
    "@fontsource/saira-stencil-one": "^5.3.0",
    "three": "^0.184.0"
  }
}
